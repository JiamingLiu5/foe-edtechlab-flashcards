# Copy to infra/.env and fill in real values before `docker compose up -d`.
# Never commit the filled-in .env file.

# --- Domain / TLS ---
# Domain Caddy will request a Let's Encrypt certificate for. Use your
# server's DNS name; for local testing without a domain, use ":80" or
# ":443, tls internal" (see infra/README.md).
APP_DOMAIN=flashcards.example.ac.uk
APP_ORIGIN=https://flashcards.example.ac.uk

# --- Postgres ---
POSTGRES_USER=flashcards
POSTGRES_PASSWORD=change-me
POSTGRES_DB=flashcards
DATABASE_URL=postgresql://flashcards:change-me@db:5432/flashcards

# --- Redis ---
REDIS_URL=redis://redis:6379

# --- Sessions ---
# Generate with: openssl rand -hex 32
SESSION_SECRET=change-me-to-a-random-64-char-hex-string

# --- Auth ---
ALLOWED_EMAIL_DOMAINS=ic.ac.uk,imperial.ac.uk

# --- Test login (optional) ---
# Leave both blank to disable. If set, GET /api/auth/dev-login?secret=... logs
# in as TEST_LOGIN_EMAIL without going through the magic-link flow. Keep the
# secret private -- treat it like a password.
TEST_LOGIN_SECRET=
TEST_LOGIN_EMAIL=

# --- Admin account (optional) ---
# Leave both blank to disable. If set, an admin account with this email/password
# is created (or resynced) on every backend startup, with role=admin and
# status=approved. New self-service signups are otherwise created with
# status=pending and require this admin to approve them at /admin before they
# can sign in. Editing ADMIN_PASSWORD/ADMIN_NAME and restarting the backend
# re-syncs the admin account's credentials/display name.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=

# --- Claude API (card generation + self-check grading) ---
# Leave ANTHROPIC_API_KEY blank to skip Claude entirely — generation and
# grading will automatically fall back to Gemini (GEMINI_MODEL_GENERATION /
# GEMINI_MODEL_GRADING below). GEMINI_API_KEY is required either way, since
# PDF OCR always runs on Gemini.
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL_GENERATION=claude-sonnet-4-5
ANTHROPIC_MODEL_GRADING=claude-haiku-4-5
DAILY_GENERATION_QUOTA=10
DAILY_GRADING_QUOTA=50
# AI deck review checks existing cards for factual/clarity issues (separate quota from imports).
DAILY_DECK_REVIEW_QUOTA=5

# --- Gemini API (PDF OCR always; also the fallback for generation + grading) ---
GEMINI_API_KEY=AI...
GEMINI_MODEL_OCR=gemini-3.5-flash-lite
GEMINI_MODEL_GENERATION=gemini-3.5-flash
GEMINI_MODEL_GRADING=gemini-3.5-flash-lite

# --- Uploads ---
UPLOAD_DIR=/data/uploads
MAX_UPLOAD_MB=20
# Cap on a fetched webpage's size for URL import.
MAX_URL_FETCH_MB=5
