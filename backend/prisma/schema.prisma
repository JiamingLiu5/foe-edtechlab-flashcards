generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  student
  teacher
  admin
}

enum UserStatus {
  pending
  approved
  rejected
  deactivated
}

model User {
  id           String     @id @default(uuid())
  email        String     @unique
  passwordHash String
  displayName  String?
  role         UserRole   @default(student)
  status       UserStatus @default(approved)
  createdAt    DateTime   @default(now())

  /// Minutes until a card comes back after each Study outcome — student-configurable, applies across all their decks.
  studyAgainMinutes Int @default(0)
  studyHardMinutes  Int @default(360)
  studyGoodMinutes  Int @default(720)
  studyEasyMinutes  Int @default(1440)

  decks          Deck[]
  reviews        Review[]
  jobsCreated    GenerationJob[]
  quotaOverrides QuotaOverride[]
  classroomsTaught Classroom[] @relation("ClassroomTeacher")
  classroomMemberships ClassroomMember[]
  quizSubmissions QuizSubmission[]

  @@map("users")
}

model Classroom {
  id        String   @id @default(uuid())
  teacherId String
  teacher   User     @relation("ClassroomTeacher", fields: [teacherId], references: [id], onDelete: Cascade)
  name      String
  joinCode  String   @unique
  createdAt DateTime @default(now())

  members ClassroomMember[]
  quizzes  ClassroomQuiz[]

  @@map("classrooms")
  @@index([teacherId])
}

model ClassroomMember {
  classroomId String
  studentId   String
  joinedAt    DateTime @default(now())
  classroom   Classroom @relation(fields: [classroomId], references: [id], onDelete: Cascade)
  student     User      @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@id([classroomId, studentId])
  @@map("classroom_members")
  @@index([studentId])
}

model ClassroomQuiz {
  id                String   @id @default(uuid())
  classroomId       String
  classroom         Classroom @relation(fields: [classroomId], references: [id], onDelete: Cascade)
  title             String
  mode              String   @default("mcq")
  difficultyFilter  String   @default("all")
  hardQuestionCount Int      @default(0)
  timerMinutes      Int      @default(0)
  showPreview       Boolean  @default(true)
  allowStudentBreakdown Boolean @default(false)
  createdAt         DateTime @default(now())

  questions   ClassroomQuizQuestion[]
  submissions QuizSubmission[]

  @@map("classroom_quizzes")
  @@index([classroomId])
}

model ClassroomQuizQuestion {
  id        String         @id @default(uuid())
  quizId    String
  quiz      ClassroomQuiz  @relation(fields: [quizId], references: [id], onDelete: Cascade)
  position  Int
  kind      String         @default("mcq")
  prompt    String
  answer    String
  correctAnswers String[]  @default([])
  options   String[]
  points    Float          @default(1)

  submissionAnswers QuizSubmissionAnswer[]

  @@map("classroom_quiz_questions")
  @@unique([quizId, position])
}

model QuizSubmission {
  id         String         @id @default(uuid())
  quizId     String
  quiz       ClassroomQuiz  @relation(fields: [quizId], references: [id], onDelete: Cascade)
  studentId  String
  student    User           @relation(fields: [studentId], references: [id], onDelete: Cascade)
  score      Float
  totalPoints Float
  submittedAt DateTime      @default(now())

  answers    QuizSubmissionAnswer[]

  @@map("quiz_submissions")
  @@unique([quizId, studentId])
  @@index([studentId])
}

model QuizSubmissionAnswer {
  id           String                 @id @default(uuid())
  submissionId String
  questionId   String
  submission   QuizSubmission         @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  question     ClassroomQuizQuestion  @relation(fields: [questionId], references: [id], onDelete: Cascade)
  selected     String[]               @default([])
  typedAnswer  String?
  pointsEarned Float                  @default(0)

  @@map("quiz_submission_answers")
  @@unique([submissionId, questionId])
  @@index([questionId])
}

/// Per-user override of a daily AI-usage quota bucket ("generation" | "grading" | "deck_review"),
/// set by an admin to replace the global env-configured default for that user.
model QuotaOverride {
  id         String   @id @default(uuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  bucket     String
  dailyLimit Int
  updatedAt  DateTime @updatedAt

  @@unique([userId, bucket])
  @@map("quota_overrides")
}

model Deck {
  id        String   @id @default(uuid())
  ownerId   String
  owner     User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  name      String
  createdAt DateTime @default(now())

  cards           Card[]
  generationJobs  GenerationJob[]
  sources         DeckSource[]

  @@map("decks")
}

/// A PDF or URL the deck was built from, retained (not just its drafted cards) so a later
/// AI review can fact-check cards against the original material instead of judging in isolation.
model DeckSource {
  id            String               @id @default(uuid())
  deckId        String
  deck          Deck                 @relation(fields: [deckId], references: [id], onDelete: Cascade)
  sourceType    GenerationSourceType
  /// Filename for a PDF, or the page title (falling back to the URL) for a URL source.
  label         String
  sourceUrl     String?
  /// Permanent on-disk path for a retained PDF; null for URL sources (no file to keep).
  storedPath    String?
  extractedText String
  createdAt     DateTime             @default(now())

  @@map("deck_sources")
  @@index([deckId])
}

model Card {
  id        String   @id @default(uuid())
  deckId    String
  deck      Deck     @relation(fields: [deckId], references: [id], onDelete: Cascade)
  front     String
  back      String
  tags      String[] @default([])
  source    String?
  includeInQuiz Boolean @default(true)
  difficulty CardDifficulty @default(medium)
  /// Cached AI-generated plausible-but-wrong MCQ options; empty until first quiz generation, cleared when front/back changes.
  distractors String[] @default([])
  /// Set via the Study page's "All done" action — excludes the card from future Study sessions until un-retired.
  retired   Boolean  @default(false)
  createdAt DateTime @default(now())

  reviews      Review[]
  originDraft  AiDraft?  @relation("AiDraftResult")
  reviewDrafts AiDraft[] @relation("AiDraftOrigin")

  @@map("cards")
  @@index([deckId])
}

enum GenerationJobStatus {
  queued
  extracting
  generating
  ready
  failed
}

/// "import" drafts cards from a fresh source (PDF/URL); "review" checks existing deck cards for issues.
enum GenerationJobKind {
  import
  review
}

enum GenerationSourceType {
  pdf
  url
  text
}

model GenerationJob {
  id             String               @id @default(uuid())
  deckId         String
  deck           Deck                 @relation(fields: [deckId], references: [id], onDelete: Cascade)
  requestedById  String
  requestedBy    User                 @relation(fields: [requestedById], references: [id], onDelete: Cascade)
  status         GenerationJobStatus  @default(queued)
  kind           GenerationJobKind    @default(import)
  sourceType     GenerationSourceType @default(pdf)
  sourceFilename String
  sourceUrl      String?
  /// The pasted study text for text imports. PDF and URL imports keep their source elsewhere.
  sourceText     String?
  uploadPath     String?
  cardLimit      Int                  @default(12)
  error          String?
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  drafts AiDraft[]

  @@map("generation_jobs")
  @@index([deckId])
}

enum AiDraftStatus {
  pending
  accepted
  discarded
}

/// An AI-estimated difficulty level used to balance quiz questions.
enum CardDifficulty {
  easy
  medium
  hard
}

model AiDraft {
  id              String        @id @default(uuid())
  jobId           String
  job             GenerationJob @relation(fields: [jobId], references: [id], onDelete: Cascade)
  generatedFront  String
  generatedBack   String
  editedFront     String?
  editedBack      String?
  sourceCitation  String?
  difficulty      CardDifficulty @default(medium)
  issue           String?
  originalCardId  String?
  originalCard    Card?         @relation("AiDraftOrigin", fields: [originalCardId], references: [id], onDelete: Cascade)
  status          AiDraftStatus @default(pending)
  resultingCardId String?       @unique
  resultingCard   Card?         @relation("AiDraftResult", fields: [resultingCardId], references: [id])
  createdAt       DateTime      @default(now())

  @@map("ai_drafts")
  @@index([jobId])
  @@index([originalCardId])
}

enum ReviewOutcome {
  again
  hard
  good
  easy
}

model Review {
  id         String        @id @default(uuid())
  userId     String
  user       User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  cardId     String
  card       Card          @relation(fields: [cardId], references: [id], onDelete: Cascade)
  reviewedAt DateTime      @default(now())
  outcome    ReviewOutcome
  dueAt      DateTime

  @@map("reviews")
  @@index([cardId])
  @@index([userId, dueAt])
}
