# Local dev only — pair with `docker compose -f infra/docker-compose.dev.yml up -d`
# for a local Postgres + Redis, then copy this to backend/.env.

DATABASE_URL=postgresql://flashcards:devpass@localhost:5432/flashcards
REDIS_URL=redis://localhost:6379
SESSION_SECRET=dev-only-secret-change-me
ALLOWED_EMAIL_DOMAINS=ic.ac.uk,imperial.ac.uk
APP_ORIGIN=http://localhost:5173

# Leave both blank to disable. If set, an admin account with this email/password
# is created (or resynced) on every backend startup, with role=admin and
# status=approved — it can sign in normally and manage users at /admin.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=

# Leave ANTHROPIC_API_KEY blank to skip Claude entirely — card generation and
# self-check grading will automatically fall back to Gemini (GEMINI_API_KEY
# is required either way, since PDF OCR always runs on Gemini).
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL_GENERATION=claude-sonnet-4-5
ANTHROPIC_MODEL_GRADING=claude-haiku-4-5

GEMINI_API_KEY=AI...
GEMINI_MODEL_OCR=gemini-3.5-flash-lite
GEMINI_MODEL_GENERATION=gemini-3.5-flash
GEMINI_MODEL_GRADING=gemini-3.5-flash-lite

UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=20
MAX_URL_FETCH_MB=5
DAILY_GENERATION_QUOTA=10
DAILY_GRADING_QUOTA=50
DAILY_DECK_REVIEW_QUOTA=5
